<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OGITECH Express | Order Terminal</title>
    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23e67e22'%3E%3Cpath d='M11 2v20H9v-2H7v-2H5v-2H3v-2H1v-2h22v2h-2v2h-2v2h-2v2h-2V2h-2zm2 5h4v2h-4zm0 4h4v2h-4zm-8 4h14v2H5zm0 4h14v2H5z'/%3E%3Cpolygon points='12,2 10,5 14,5' fill='%23d4af37'/%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="/socket.io/socket.io.js"></script>

    <style>
        :root {
            --bg-master: #ffffff;
            --bg-surface: #141419;
            --bg-surface-elevated: #1d1d26;
            --accent-primary: #E63946; 
            --accent-hover: #d62828;
            --accent-gold: #d4af37;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-glow: #2a2a35;
            --shadow-premium: 0 10px 30px rgba(0,0,0,0.5);
        }

        body { 
            font-family: 'Poppins', sans-serif; 
            margin: 0; 
            background-color: var(--bg-master); 
            color: var(--text-main); 
            display: flex; 
            min-height: 100vh;
        }

        /* Top Mobile Header (Hidden on Desktop) */
        .mobile-header {
            display: none;
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border-glow);
            padding: 12px 20px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            align-items: center;
            justify-content: space-between;
            height: 60px;
            box-sizing: border-box;
        }

        .mobile-brand-title {
            display: flex;
            flex-direction: column;
        }

        .mobile-brand-title h2 {
            margin: 0;
            color: #fff;
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            line-height: 1.2;
        }

        .mobile-brand-title span {
            color: var(--accent-primary);
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .mobile-toggle-btn {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-glow);
            color: #fff;
            font-size: 20px;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .mobile-toggle-btn:hover {
            background: var(--bg-surface-elevated);
        }

        /* Sidebar Backdrop Overlay */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(3px);
            z-index: 140;
        }

        .sidebar-backdrop.active {
            display: block;
        }

        /* App Sidebar Navigation Drawer */
        .app-sidebar { 
            width: 300px; 
            background: var(--bg-surface); 
            padding: 25px 20px; 
            border-right: 1px solid var(--border-glow); 
            display: flex; 
            flex-direction: column; 
            gap: 12px; 
            box-sizing: border-box;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 150;
            transition: transform 0.3s ease;
        }

        .brand-header {
            text-align: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-glow);
            margin-bottom: 10px;
        }

        .brand-header h2 {
            margin: 0;
            color: #fff;
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .brand-header span {
            color: var(--accent-primary);
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .nav-link-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 14px 16px;
            color: var(--text-muted);
            background: transparent;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            border: 1px solid transparent;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s;
        }

        .nav-link-btn:hover {
            background: var(--bg-surface-elevated);
            color: #fff;
        }

        .nav-link-btn.active {
            background: rgba(230, 57, 70, 0.1);
            color: var(--accent-primary);
            border-color: rgba(230, 57, 70, 0.3);
        }

        .main-wrapper { 
            margin-left: 300px; 
            flex: 1; 
            padding: 40px; 
            box-sizing: border-box;
            max-width: calc(100% - 300px);
        }

        .tab-content { display: none; animation: fadeIn 0.4s ease; }
        .tab-content.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h3 { 
            border-left: 4px solid var(--accent-primary); 
            padding-left: 12px; 
            color: #fff; 
            margin-top: 0; 
            margin-bottom: 25px; 
            font-weight: 700; 
            font-size: 1.4rem; 
        }

        .algo-infobar { 
            background: rgba(52, 152, 219, 0.05); 
            border: 1px solid rgba(52, 152, 219, 0.15); 
            padding: 10px 16px; 
            border-radius: 8px; 
            margin-bottom: 25px; 
            display: flex; 
            align-items: center; 
            justify-content: space-between; 
            border-left: 4px solid #3498db; 
        }
        .algo-title { font-size: 12px; font-weight: 500; text-transform: uppercase; color: #3498db; margin: 0; }

        .form-section-title {
            font-weight: 600;
            color: var(--text-muted);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 25px 0 10px 0;
            display: block;
        }

        .accordion-btn {
            width: 100%;
            background: var(--bg-surface);
            border: 1px solid var(--border-glow);
            color: #fff;
            padding: 16px 20px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            text-align: left;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
        }

        .accordion-btn:hover {
            border-color: var(--accent-primary);
            background: var(--bg-surface-elevated);
        }

        .accordion-icon {
            transition: transform 0.3s ease;
            font-size: 14px;
            color: var(--accent-primary);
        }

        .accordion-btn.active .accordion-icon {
            transform: rotate(180deg);
        }

        .meal-collapse-wrapper {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0, 1, 0, 1);
            margin-top: 10px;
        }

        .meal-collapse-wrapper.open {
            max-height: 1200px;
            transition: max-height 0.5s ease-in-out;
            overflow-y: auto;
            padding-bottom: 10px;
        }

        .selected-summary-box {
            display: none;
            background: rgba(46, 204, 113, 0.1);
            border: 1px solid #2ecc71;
            padding: 14px 18px;
            border-radius: 8px;
            margin-top: 12px;
            color: #2ecc71;
            font-weight: 600;
            font-size: 14px;
            align-items: center;
            justify-content: space-between;
        }

        .meal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 15px;
            padding-top: 5px;
        }

        .meal-radio { display: none; }
        
        .meal-card {
            background: var(--bg-surface);
            border: 2px solid var(--border-glow);
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
            height: 100%;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .meal-card:hover {
            border-color: #555;
            transform: translateY(-2px);
        }

        .meal-radio:checked + .meal-card {
            border-color: var(--accent-primary);
            background: rgba(230, 57, 70, 0.08);
            box-shadow: 0 4px 15px rgba(230, 57, 70, 0.2);
        }

        .meal-img-box {
            width: 100%;
            height: 130px;
            border-radius: 8px;
            overflow: hidden;
            background: #202028;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .meal-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .meal-icon-fallback { font-size: 40px; }

        .meal-name { font-size: 14px; font-weight: 700; color: #fff; margin: 0 0 6px 0; line-height: 1.3; }
        .meal-price { font-size: 16px; font-weight: 700; color: var(--accent-primary); margin: 0; }
        .meal-prep { font-size: 11px; color: var(--text-muted); margin-top: 6px; }

        .input-row { display: flex; gap: 20px; margin-bottom: 20px; }
        .input-group { flex: 1; }
        
        input[type="text"], input[type="email"], select { 
            width: 100%; 
            padding: 14px; 
            border: 1px solid var(--border-glow); 
            border-radius: 8px; 
            font-size: 14px; 
            background: var(--bg-surface); 
            color: #fff; 
            font-family: 'Poppins', sans-serif; 
            box-sizing: border-box;
            transition: border-color 0.2s;
        }
        
        input:focus, select:focus { border-color: var(--accent-primary); outline: none; }

        .payment-notice {
            background: rgba(52, 152, 219, 0.1);
            border: 1px dashed #3498db;
            color: #3498db;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .error-alert {
            background: rgba(230, 57, 70, 0.15);
            border: 1px solid var(--accent-primary);
            color: #ff8080;
            padding: 14px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .order-dispatch-btn { 
            width: 100%;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-hover)); 
            color: white; 
            border: none; 
            padding: 16px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 700; 
            cursor: pointer; 
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px rgba(230, 57, 70, 0.3);
            transition: transform 0.2s;
        }
        .order-dispatch-btn:hover { transform: translateY(-2px); }
        .order-dispatch-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

        .table-responsive { width: 100%; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; background: var(--bg-surface); border-radius: 8px; overflow: hidden; }
        th, td { border-bottom: 1px solid var(--border-glow); padding: 16px; text-align: left; font-size: 14px; }
        th { background-color: var(--bg-surface-elevated); color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px; }
        tr:last-child td { border-bottom: none; }
        
        .badge-wait { background: #d35400; color: white; padding: 4px 10px; border-radius: 4px; font-weight: 600; font-size: 11px; text-transform: uppercase; }
        .badge-vip { background: #9b59b6; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .vip-row { border-left: 4px solid #9b59b6; background-color: rgba(155, 89, 182, 0.05); }

        .search-box form { display: flex; gap: 10px; margin-bottom: 25px; }
        .search-box button { background: #9b59b6; color: white; border: none; padding: 0 25px; border-radius: 8px; font-weight: 600; cursor: pointer; }
        .status-box { background: #1d3828; color: #2ecc71; padding: 20px; border-radius: 8px; border-left: 5px solid #2ecc71; line-height: 1.6; font-size: 14px; }

        .receipt-wrapper { background: #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.2); padding: 25px; width: 100%; max-width: 320px; margin: 0 auto 30px auto; font-family: 'Courier New', Courier, monospace; color: #000; text-align: center; border-radius: 8px; border-top: 6px solid var(--accent-primary); }
        .receipt-line { border-top: 1px dashed #ccc; margin: 15px 0; }
        .btn-print { background-color: #2c3e50; color: white; padding: 12px; border: none; border-radius: 8px; margin-bottom: 25px; width: 100%; max-width: 370px; display: block; margin-left: auto; margin-right: auto; font-weight: 600; cursor: pointer; }

        .footer-bot-btn { position: fixed; bottom: 25px; right: 25px; background: #a855f7; color: #fff; border: none; padding: 12px 20px; border-radius: 30px; font-weight: 600; font-size: 14px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 6px 20px rgba(168, 85, 247, 0.35); z-index: 1000; }
        .live-chat-panel { position: fixed; bottom: 85px; right: 25px; width: 350px; height: 480px; background: #141419; border: 1px solid #2a2a35; border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,0.7); z-index: 1001; display: none; flex-direction: column; overflow: hidden; }
        .chat-header { background: #a855f7; padding: 15px; display: flex; justify-content: space-between; align-items: center; color: white; font-weight: 700; }
        .chat-close-btn { background: transparent; border: none; color: white; font-size: 20px; cursor: pointer; }
        .chat-message-area { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; background: #0a0a0c; }
        .msg-bubble { max-width: 80%; padding: 10px 14px; border-radius: 12px; font-size: 13px; line-height: 1.5; }
        .msg-bot { background: #27272a; color: #f4f4f5; align-self: flex-start; border-bottom-left-radius: 2px; }
        .msg-user { background: #a855f7; color: #fff; align-self: flex-end; border-bottom-right-radius: 2px; }
        .chat-input-row { padding: 10px; background: #141419; border-top: 1px solid #2a2a35; display: flex; gap: 8px; }
        .chat-input-row input { flex: 1; padding: 10px; background: #0a0a0c; border: 1px solid #2a2a35; color: white; border-radius: 6px; }
        .chat-send-btn { background: #a855f7; color: white; border: none; padding: 0 15px; border-radius: 6px; cursor: pointer; font-weight: 600; }

        /* Responsive Styles for Mobile (< 768px) */
        @media (max-width: 768px) {
            body { flex-direction: column; }
            
            .mobile-header { display: flex; }

            .app-sidebar {
                width: 270px;
                transform: translateX(-100%);
                box-shadow: 10px 0 30px rgba(0, 0, 0, 0.8);
            }

            .app-sidebar.open {
                transform: translateX(0);
            }

            .main-wrapper {
                margin-left: 0;
                max-width: 100%;
                padding: 75px 15px 25px 15px;
            }

            .input-row {
                flex-direction: column;
                gap: 15px;
            }

            .search-box form {
                flex-direction: column;
            }

            .search-box button {
                padding: 12px;
            }

            .live-chat-panel {
                width: calc(100vw - 30px);
                right: 15px;
                left: 15px;
                bottom: 80px;
            }
        }

        @media print {
            body * { visibility: hidden; }
            #targetReceiptPrintOut, #targetReceiptPrintOut * { visibility: visible; }
            #targetReceiptPrintOut { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 100%; scale: 1.2; box-shadow: none; }
        }
    </style>
</head>
<body>

<!-- Mobile Header Bar -->
<header class="mobile-header">
    <div class="mobile-brand-title">
        <h2>OGITECH</h2>
        <span>Food Express Terminal</span>
    </div>
    <button class="mobile-toggle-btn" onclick="toggleSidebarDrawer()">☰</button>
</header>

<!-- Backdrop Overlay for Mobile Drawer -->
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebarDrawer()"></div>

<!-- Slide-over Mobile Sidebar -->
<div class="app-sidebar" id="customerSidebar">
    <div class="brand-header">
        <h2>OGITECH</h2>
        <span>Food Express Terminal</span>
    </div>

    <button class="nav-link-btn active" onclick="switchTab(event, 'placeOrderTab')">
        🛒 Place Food Order
    </button>
    <button class="nav-link-btn" onclick="switchTab(event, 'orderTrackerTab')">
        🔎 Order Status Tracker
    </button>
    <button class="nav-link-btn" onclick="switchTab(event, 'kitchenQueueTab')">
        🍳 Kitchen Queue Status
    </button>

    <div style="margin-top: auto; padding: 15px; background: rgba(255,255,255,0.02); border-radius: 8px; border: 1px solid var(--border-glow);">
        <p style="margin: 0 0 5px 0; font-size: 12px; color: var(--text-muted); font-weight: 600;">🕒 Operating Hours</p>
        <p style="margin: 0; font-size: 12px; color: #fff;">Mon-Sat | 8:00 AM – 8:00 PM</p>
    </div>
</div>

<div class="main-wrapper" id="order-terminal">
    
    <div id="placeOrderTab" class="tab-content active">
        
        <% if (locals.successMsg && locals.ticket) { %>
            <div id="targetReceiptPrintOut" class="receipt-wrapper">
                <h4 style="margin:0 0 5px 0; font-weight:800; font-size: 18px;">OGITECH CAFE</h4>
                <small style="font-size:11px; color:#666;">E-Ordering Token System</small>
                <div class="receipt-line"></div>
                <p style="font-size:11px; margin:4px 0; color:#555; font-weight: bold;">UNIQUE TRACKING CODE</p>
                <p style="font-size: 26px; font-weight: 900; margin: 5px 0; color: var(--accent-primary);"><%= ticket.orderId %></p>
                <div class="receipt-line"></div>
                
                <div style="background: #f8fafc; padding: 15px; border: 1px dashed #cbd5e1; border-radius: 6px; margin: 15px 0;">
                    <p style="margin: 0; font-size: 11px; font-weight: 700; color: #475569;">🔢 LIVE QUEUE PLACEMENT</p>
                    <p style="margin: 5px 0; font-size: 24px; font-weight: 800; color: #0f172a;">Position #<%= ticket.queuePosition %></p>
                    <div style="border-top: 1px dashed #cbd5e1; margin: 10px 0;"></div>
                    <p style="margin: 0; font-size: 12px; font-weight: 700; color: #15803d;">⏰ EST. PREP: 10 MINS</p>
                </div>

                <p style="text-align:left; margin:6px 0; font-size:13px;"><b>Name:</b> <%= ticket.customerName %></p>
                <p style="text-align:left; margin:6px 0; font-size:13px;"><b>Item:</b> <%= ticket.quantity %>x <%= ticket.foodName %></p>
                <p style="text-align:left; margin:6px 0; font-size:13px;"><b>Class:</b>
                    <% if (ticket.priority === 1) { %>
                        <span style="font-weight:bold; color:#9b59b6;">VIP FAST-TRACK</span>
                    <% } else { %>
                        <span style="font-weight:bold; color:#555;">STANDARD</span>
                    <% } %>
                </p>
                
                <div class="receipt-line"></div>
                <p style="font-size:16px; margin:4px 0; text-align:right; font-weight:bold;">TOTAL BILL: ₦<%= ticket.totalPrice.toLocaleString() %></p>
                <div class="receipt-line"></div>
                <p style="font-size: 10px; color: #888;">Present this token at the counter for pickup.</p>
            </div>
            <button onclick="window.print();" class="btn-print">🖨 Print Digital Receipt</button>
        <% } %>

        <% if (locals.error) { %>
            <div class="error-alert">
                ⚠️ <span>An error occurred with order processing (<%= locals.error %>). Please check your connection and details, then try again.</span>
            </div>
        <% } %>

        <div class="algo-infobar">
            <span class="algo-title">🤖 Active Kitchen Optimizer Mode:</span>
            <span style="background: #E63946; color: #fff; padding: 4px 12px; font-size: 11px; font-weight: 700; border-radius: 20px; text-transform: uppercase;">
                <%= locals.algo === 'sjf' ? 'Shortest Job First (SJF)' : 'First-In, First-Out (FIFO)' %>
            </span>
        </div>

        <h3>🛒 Build Your Order</h3>
        
        <form action="/place-order" method="POST" id="premiumOrderForm">
            <span class="form-section-title">1. Your Details</span>
            <div class="input-row">
                <div class="input-group">
                    <input type="text" name="customerName" placeholder="Enter your first name" required>
                </div>
                <div class="input-group">
                    <input type="email" name="customerEmail" placeholder="Email Address (For e-receipt)" required>
                </div>
            </div>

            <span class="form-section-title">2. Select Your Meal</span>
            
            <button type="button" class="accordion-btn" id="toggleMenuBtn" onclick="toggleMenuAccordion()">
                <span id="accordionLabel">▼ Click here to open available meal menu</span>
                <span class="accordion-icon">▼</span>
            </button>

            <div id="selectedSummary" class="selected-summary-box">
                <span>Selected: <strong id="summaryDishName" style="color:#fff;">-</strong></span>
                <span id="summaryDishPrice" style="color:var(--accent-gold); font-weight:700;">₦0</span>
            </div>

            <div id="mealCollapseContainer" class="meal-collapse-wrapper">
                <div class="meal-grid">
                    <% if (locals.menu && menu.length > 0) { %>
                        <% menu.forEach((dish, index) => { %>
                            <label>
                                <input type="radio" name="foodId" value="<%= dish._id %>" class="meal-radio" required data-name="<%= dish.name %>" data-price="<%= dish.price %>" onchange="handleMealSelection(this)">
                                <div class="meal-card">
                                    <div class="meal-img-box">
                                        <% if (dish.imageUrl || dish.image) { %>
                                            <img src="<%= dish.imageUrl || dish.image %>" alt="<%= dish.name %>" loading="lazy">
                                        <% } else { %>
                                            <div class="meal-icon-fallback">🍱</div>
                                        <% } %>
                                    </div>
                                    <h4 class="meal-name"><%= dish.name %></h4>
                                    <p class="meal-price">₦<%= dish.price.toLocaleString() %></p>
                                    <p class="meal-prep">Est. Prep: 10-15 mins</p>
                                </div>
                            </label>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #888; padding: 20px;">No menu items available currently.</p>
                    <% } %>
                </div>
            </div>

            <span class="form-section-title" id="step3Target" style="scroll-margin-top: 30px;">3. Order Configuration</span>
            <div class="input-row">
                <div class="input-group">
                    <label style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 5px;">Number of Plates</label>
                    <select name="quantity" id="quantity" onchange="calculateTotalBill()">
                        <option value="1">1 Plate (Single)</option>
                        <option value="2">2 Plates (Double)</option>
                        <option value="3">3 Plates</option>
                        <option value="4">4 Plates</option>
                        <option value="5">5 Plates (Family)</option>
                    </select>
                </div>
                <div class="input-group">
                    <label style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 5px;">Processing Speed</label>
                    <select name="priority" id="priority" onchange="calculateTotalBill()">
                        <option value="0">Standard Queue (Regular Base Price)</option>
                        <option value="1">VIP Fast-Track (+₦500 Priority Processing)</option>
                    </select>
                </div>
            </div>

            <!-- Live Total Bill Preview Box -->
            <div id="liveTotalBillBox" style="background: rgba(230, 57, 70, 0.1); border: 1px solid var(--accent-primary); padding: 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
                <span style="font-weight: 600; font-size: 14px; color: #fff;">Estimated Total Bill:</span>
                <span id="displayTotalAmount" style="font-size: 20px; font-weight: 800; color: var(--accent-primary);">₦0</span>
            </div>

            <div class="payment-notice">
                🛎️ <b>💳 ONLINE PAYMENT REQUIRED:</b> Complete your payment securely to dispatch your order and generate your instant meal token.
            </div>

            <button type="submit" class="order-dispatch-btn" id="submitBtn">
                <span id="btnText">🍳 Place Order to Kitchen</span>
            </button>
        </form>
    </div>

    <div id="orderTrackerTab" class="tab-content">
        <h3>🔎 Personal Order Status Tracker</h3>
        <p style="color: var(--text-muted); margin-bottom: 20px;">Enter the unique tracking code from your digital receipt to check your meal's live progress.</p>
        
        <div class="search-box">
            <form action="/order" method="GET">
                <input type="text" name="searchId" placeholder="e.g., OGI-X8W2" value="<%= locals.searchQuery || '' %>" required>
                <button type="submit">Track Token</button>
            </form>

            <% if (locals.searchResult) { %>
                <% if (searchResult.status === 'Preparing') { %>
                    <div class="status-box" style="background: #342609; border-left-color: #f1c40f; color: #f1c40f;">
                        ⏳ <b>TICKET FOUND: <%= searchResult.orderId %></b><br><br>
                        <b>Queue Rank:</b> Position #<%= searchResult.queuePosition %><br>
                        <b>Est. Ready Time:</b> <%= searchResult.estimatedTime %><br>
                        <b>Status:</b> Kitchen is actively preparing your meal.
                    </div>
                <% } else if (searchResult.status === 'Ready for Pickup') { %>
                    <div class="status-box">
                        🎉 <b>🟢 MEAL READY FOR PICKUP</b><br><br>
                        <b>Ticket:</b> <%= searchResult.orderId %><br>
                        <b>Details:</b> <%= searchResult.quantity %>x <%= searchResult.foodName %><br>
                        <p style="margin:10px 0 0 0; color:#fff; border-top:1px dashed #2ecc71; padding-top:10px;">
                            👉 Please proceed to the kitchen counter and present your Order ID to collect your meal plate!
                        </p>
                    </div>
                <% } else if (searchResult.status === 'Collected') { %>
                    <div class="status-box" style="background: var(--bg-surface-elevated); border-left-color: #6c757d; color: #aaa;">
                        ✅ <b>ORDER COLLECTED</b><br><br>
                        <b>Ticket Code:</b> <%= searchResult.orderId %><br>
                        <b>Log Status:</b> Handed over to client. Thank you for dining with OGITECH Food Express!
                    </div>
                <% } %>
            <% } else if (locals.searchQuery && locals.searchError) { %>
                <div class="status-box" style="background:#3a1616; color:#ff9999; border-left-color:#e74c3c;">
                    ❌ Token code <b><%= searchQuery %></b> not recognized by system records.
                </div>
            <% } %>
        </div>
    </div>

    <div id="kitchenQueueTab" class="tab-content">
        <h3>🍳 Live Kitchen Queue Status</h3>
        <p style="color: var(--text-muted); margin-bottom: 20px;">Public view of active orders currently being processed by the kitchen algorithm.</p>
        
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Customer Name</th>
                        <th>Meal Item</th>
                        <th>Est. Wait</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (locals.jobs && jobs.length > 0) { %>
                        <% jobs.forEach((job, index) => { %>
                            <tr class="<%= job.priority === 1 ? 'vip-row' : '' %>">
                                <td><b>#<%= index + 1 %></b></td>
                                <td>
                                    <%= job.customerName %>
                                    <% if (job.priority === 1) { %> <span class="badge-vip">VIP</span> <% } %>
                                </td>
                                <td><%= job.quantity %>x <%= job.foodName %></td>
                                <td>~<%= Math.min(job.processingTime * job.quantity, 10) %> mins</td>
                                <td><span class="badge-wait"><%= job.status %></span></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5" style="text-align:center; color:#777; padding:30px;">Kitchen is currently clear. No active orders.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<button onclick="toggleChatWindow()" class="footer-bot-btn">💬 Help / Support</button>

<div id="liveChatWidgetPanel" class="live-chat-panel">
    <div class="chat-header">
        <span>🤖 OGITECH Support Hub</span>
        <button onclick="toggleChatWindow()" class="chat-close-btn">&times;</button>
    </div>
    
    <div class="chat-message-area" id="chatMsgConsole">
        <div class="msg-bubble msg-bot">
            Hello! Welcome to the OGITECH Help Desk. Having trouble placing an order or tracking your meal?
        </div>
    </div>

    <div class="chat-input-row">
        <input type="text" id="userChatInput" placeholder="Type a message..." onkeypress="handleChatEnter(event)">
        <button class="chat-send-btn" onclick="sendTerminalChatMessage()">Send</button>
    </div>
</div>

<div id="url-data" data-search="<%= locals.searchQuery ? 'true' : 'false' %>" data-success="<%= locals.successMsg ? 'true' : 'false' %>" style="display:none;"></div>

<script>
    const clientSocket = io();

    clientSocket.on('queueUpdate', () => {
        const nameInput = document.querySelector('input[name="customerName"]').value;
        if (!nameInput) {
            window.location.reload();
        }
    });

    function toggleSidebarDrawer() {
        const sidebar = document.getElementById('customerSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        sidebar.classList.toggle('open');
        backdrop.classList.toggle('active');
    }

    function toggleMenuAccordion() {
        const container = document.getElementById('mealCollapseContainer');
        const btn = document.getElementById('toggleMenuBtn');
        const label = document.getElementById('accordionLabel');

        container.classList.toggle('open');
        btn.classList.toggle('active');

        if (container.classList.contains('open')) {
            label.innerText = '▲ Click to close menu dropdown';
        } else {
            label.innerText = '▼ Click here to open available meal menu';
        }
    }

    let currentBasePrice = 0;

    function handleMealSelection(radioElement) {
        const dishName = radioElement.getAttribute('data-name');
        const rawPrice = radioElement.getAttribute('data-price');
        
        currentBasePrice = parseInt(rawPrice) || 0;
        const formattedPrice = currentBasePrice.toLocaleString();

        document.getElementById('summaryDishName').innerText = dishName;
        document.getElementById('summaryDishPrice').innerText = '₦' + formattedPrice;
        document.getElementById('selectedSummary').style.display = 'flex';

        document.getElementById('accordionLabel').innerText = '✓ Selected: ' + dishName;

        const container = document.getElementById('mealCollapseContainer');
        const btn = document.getElementById('toggleMenuBtn');
        container.classList.remove('open');
        btn.classList.remove('active');

        calculateTotalBill();

        setTimeout(() => {
            document.getElementById('step3Target').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 200);
    }

    function calculateTotalBill() {
        const quantity = parseInt(document.getElementById('quantity').value) || 1;
        const prioritySelect = document.getElementById('priority').value;
        const vipFee = (prioritySelect === '1') ? 500 : 0;

        const totalBill = (currentBasePrice * quantity) + vipFee;
        document.getElementById('displayTotalAmount').innerText = '₦' + totalBill.toLocaleString();
    }

    function switchTab(event, tabId) {
        const tabContents = document.querySelectorAll('.tab-content');
        tabContents.forEach(content => content.classList.remove('active'));

        const navButtons = document.querySelectorAll('.nav-link-btn');
        navButtons.forEach(btn => btn.classList.remove('active'));

        document.getElementById(tabId).classList.add('active');
        if (event) {
            event.currentTarget.classList.add('active');
        } else {
            const targetBtn = Array.from(navButtons).find(btn => btn.getAttribute('onclick').includes(tabId));
            if (targetBtn) targetBtn.classList.add('active');
        }

        // Close mobile drawer on tab switch
        const sidebar = document.getElementById('customerSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        if (sidebar.classList.contains('open')) {
            sidebar.classList.remove('open');
            backdrop.classList.remove('active');
        }
    }

    const form = document.getElementById('premiumOrderForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');

    if (form) {
        form.addEventListener('submit', function(e) {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.7';
            submitBtn.style.cursor = 'wait';
            btnText.innerText = "Dispatching Order to Kitchen Queue...";
        });
    }

    window.addEventListener('DOMContentLoaded', () => {
        const routeData = document.getElementById('url-data');
        if (routeData.dataset.search === 'true') {
            switchTab(null, 'orderTrackerTab');
        } else if (routeData.dataset.success === 'true') {
            switchTab(null, 'placeOrderTab');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });

    function toggleChatWindow() {
        const panel = document.getElementById('liveChatWidgetPanel');
        panel.style.display = panel.style.display === 'flex' ? 'none' : 'flex';
        if(panel.style.display === 'flex') {
            const consoleArea = document.getElementById('chatMsgConsole');
            consoleArea.scrollTop = consoleArea.scrollHeight;
        }
    }

    function handleChatEnter(e) { if (e.key === 'Enter') sendTerminalChatMessage(); }

    function sendTerminalChatMessage() {
        const inputField = document.getElementById('userChatInput');
        const consoleArea = document.getElementById('chatMsgConsole');
        const text = inputField.value.trim();
        if (!text) return;

        const userBubble = document.createElement('div');
        userBubble.className = 'msg-bubble msg-user';
        userBubble.innerText = text;
        consoleArea.appendChild(userBubble);
        inputField.value = '';
        consoleArea.scrollTop = consoleArea.scrollHeight;

        setTimeout(() => {
            const botBubble = document.createElement('div');
            botBubble.className = 'msg-bubble msg-bot';
            const upperText = text.toUpperCase();
            if (upperText.includes('PAY') || upperText.includes('MONEY') || upperText.includes('CASH')) {
                botBubble.innerText = "Orders are placed directly to the kitchen queue. You can check your total bill instantly before submitting.";
            } else if (upperText.includes('MENU') || upperText.includes('FOOD')) {
                botBubble.innerText = "Click on '2. Select Your Meal' to drop down and view all current dishes from the admin database!";
            } else {
                botBubble.innerText = "For urgent assistance, reach our desk directly at +234 702 685 2515.";
            }
            consoleArea.appendChild(botBubble);
            consoleArea.scrollTop = consoleArea.scrollHeight;
        }, 800);
    }
</script>

</body>
</html>