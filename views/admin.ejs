<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OGITECH Restaurant - Executive Administration Dashboard</title>
    
    <!-- Dynamic Browser Tab Favicon Icon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%233498db'%3E%3Cpath d='M11 2v20H9v-2H7v-2H5v-2H3v-2H1v-2h22v2h-2v2h-2v2h-2v2h-2V2h-2zm2 5h4v2h-4zm0 4h4v2h-4zm-8 4h14v2H5zm0 4h14v2H5z'/%3E%3Cpolygon points='12,2 10,5 14,5' fill='%23d4af37'/%3E%3C/svg%3E">

    <!-- Fonts Import -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-master: #0a0a0c;
            --bg-surface: #141419;
            --bg-surface-elevated: #1d1d26;
            --accent-blue: #3498db;
            --accent-blue-hover: #2980b9;
            --accent-orange: #e67e22;
            --accent-purple: #9b59b6;
            --accent-green: #2ecc71;
            --accent-red: #e74c3c;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-glow: #2a2a35;
            --shadow-premium: 0 20px 40px rgba(0,0,0,0.6);
        }

        body { 
            font-family: 'Poppins', sans-serif; 
            margin: 0; 
            padding: 0;
            background-color: var(--bg-master); 
            color: var(--text-main); 
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* --- SIDEBAR NAVIGATION --- */
        .admin-sidebar {
            width: 280px;
            background: var(--bg-surface);
            border-right: 1px solid var(--border-glow);
            display: flex;
            flex-direction: column;
            padding: 25px 20px;
            box-sizing: border-box;
            z-index: 10;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            color: var(--accent-blue);
            text-align: center;
            border-bottom: 2px solid var(--border-glow);
            padding-bottom: 15px;
            margin-top: 0;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
        }

        .tab-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-muted);
            padding: 12px 15px;
            text-align: left;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tab-btn:hover {
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-main);
        }

        .tab-btn.active {
            background: rgba(52, 152, 219, 0.1);
            border: 1px solid rgba(52, 152, 219, 0.3);
            color: var(--accent-blue);
            font-weight: 600;
        }

        .stats-card {
            background: rgba(52, 152, 219, 0.02);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid var(--border-glow);
            margin-bottom: 20px;
        }

        .logout-btn { 
            padding: 14px 15px; 
            background: linear-gradient(135deg, var(--accent-red), #c0392b); 
            color: white; 
            text-decoration: none; 
            border-radius: 8px; 
            font-weight: 600; 
            text-align: center; 
            font-size: 14px; 
            transition: all 0.3s ease; 
            border: none;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 12px rgba(231, 76, 60, 0.2);
        }
        .logout-btn:hover { opacity: 0.9; transform: translateY(-1px); }

        /* --- MAIN CONTENT AREA --- */
        .admin-main {
            flex: 1;
            overflow-y: auto;
            padding: 40px;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        .tab-content { display: none; animation: fadeIn 0.3s ease; }
        .tab-content.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h3 { 
            color: #5dade2; 
            margin-top: 0; 
            margin-bottom: 20px;
            border-left: 4px solid #5dade2; 
            padding-left: 12px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            font-size: 1.15rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .section-box {
            background: var(--bg-surface); 
            padding: 25px; 
            border-radius: 16px; 
            border: 1px solid var(--border-glow); 
            box-shadow: var(--shadow-premium);
            margin-bottom: 30px;
        }

        /* --- TABLES & FORMS --- */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 10px; }
        th, td { border: 1px solid var(--border-glow); padding: 14px 12px; text-align: left; font-size: 13px; }
        th { background-color: var(--bg-master); color: var(--accent-blue); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
        tr:nth-child(even) { background-color: rgba(255, 255, 255, 0.01); }
        
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px; }
        .form-group { display: flex; flex-direction: column; gap: 5px; }
        .form-group.full-width { grid-column: span 2; }
        
        label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; }
        input, select, textarea {
            padding: 12px; 
            background: var(--bg-master); 
            color: #fff; 
            border: 1px solid var(--border-glow); 
            border-radius: 8px; 
            font-family: 'Poppins', sans-serif;
            box-sizing: border-box;
            width: 100%;
        }
        input:focus, select:focus { border-color: var(--accent-blue); outline: none; }

        .btn-primary { 
            padding: 12px 20px; 
            background: linear-gradient(135deg, var(--accent-blue), #2980b9); 
            border: none; 
            color: white; 
            font-weight: 600; 
            border-radius: 8px; 
            cursor: pointer; 
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: transform 0.2s, opacity 0.2s;
        }
        .btn-primary:hover { transform: translateY(-1px); opacity: 0.95; }
        
        .btn-algo { background: linear-gradient(135deg, var(--accent-orange), #d35400); }
        .btn-success { background: linear-gradient(135deg, var(--accent-green), #27ae60); }
        
        .btn-action { padding: 6px 12px; border: none; color: white; font-weight: 600; border-radius: 4px; cursor: pointer; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
        .btn-action.red { background: linear-gradient(135deg, var(--accent-red), #c0392b); }
        .btn-action.green { background: linear-gradient(135deg, var(--accent-green), #27ae60); }
        .btn-action:hover { opacity: 0.9; }

        .badge-vip { background: var(--accent-purple); color: white; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .badge-std { background: #7f8c8d; color: white; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .stat-count-badge { color: #fff; font-size: 11px; padding: 4px 12px; border-radius: 20px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .orange-badge { background: #d35400; }
        .green-badge { background: var(--accent-green); }
    </style>
</head>
<body>

    <%
    // Inline Helper Function Fallback
    const formatTime = (dateInput) => {
        if (!dateInput) return 'N/A';
        const d = new Date(dateInput);
        if (isNaN(d.getTime())) return 'N/A';
        return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
    };
    %>

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <h2 class="brand-title">OGITECH<br><span style="font-size:0.8rem; color:var(--text-muted);">Executive Admin</span></h2>
        
        <div class="stats-card">
            <p style="font-size:12px; color:var(--text-muted); margin:0 0 2px 0;">Gross Income</p>
            <p style="font-size: 22px; font-weight: bold; color: var(--accent-green); margin:0 0 12px 0;">₦<%= locals.revenue ? Number(revenue).toLocaleString() : '0' %></p>
            <p style="font-size:12px; color:var(--text-muted); margin:0 0 2px 0;">Dispatched</p>
            <p style="font-size: 16px; font-weight: bold; color: var(--accent-blue); margin:0;"><%= locals.completedCount || 0 %> Plates</p>
        </div>

        <nav class="nav-menu">
            <button class="tab-btn active" onclick="switchTab('tab-dashboard')">📊 Live Dashboard</button>
            <button class="tab-btn" onclick="switchTab('tab-meals')">🍔 Meal Management</button>
            <button class="tab-btn" onclick="switchTab('tab-webhook')">⚡ Webhook Vault</button>
            <button class="tab-btn" onclick="switchTab('tab-ledger')">📜 Settled Ledger</button>
            <button class="tab-btn" onclick="switchTab('tab-settings')">⚙️ System Settings</button>
        </nav>

        <a href="/admin-logout" class="logout-btn" style="margin-top:auto;">🔒 Secure Logout</a>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="admin-main">
        
        <!-- TAB 1: DASHBOARD -->
        <div id="tab-dashboard" class="tab-content active">
            <div class="section-box">
                <h3>
                    <span>🍳 Active Kitchen Workload Queue</span>
                    <span class="stat-count-badge orange-badge"><%= locals.jobs ? jobs.length : 0 %> Pending</span>
                </h3>
                <table>
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Order ID</th>
                            <th>Inbound Time</th>
                            <th>Customer</th>
                            <th>Order Details</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!locals.jobs || jobs.length === 0) { %>
                            <tr><td colspan="6" style="text-align:center; color: #777; padding: 20px;">No active dishes are cooking in the kitchen right now.</td></tr>
                        <% } else { %>
                            <% jobs.forEach((job, index) => { %>
                                <tr>
                                    <td><b>#<%= index + 1 %></b></td>
                                    <td><code style="color:#f1c40f;"><%= job.orderId || 'N/A' %></code></td>
                                    <td style="color:#777;"><%= formatTime(job.createdAt) %></td>
                                    <td><%= job.customerName || 'Anonymous' %> <span class="<%= job.priority === 1 ? 'badge-vip' : 'badge-std' %>"><%= job.priority === 1 ? 'VIP' : 'STD' %></span></td>
                                    <td>
                                        <%= job.quantity || 1 %>x <%= job.foodName || 'Food Item' %><br>
                                        <small style="color: #2ecc71; font-weight: bold;">₦<%= (job.totalPrice || 0).toLocaleString() %></small>
                                    </td>
                                    <td><%= (job.processingTime || 0) * (job.quantity || 1) %> mins</td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="section-box">
                <h3>
                    <span>⏳ Counter Pickup Desk</span>
                    <span class="stat-count-badge orange-badge"><%= locals.pendingPickup ? pendingPickup.length : 0 %> Pending</span>
                </h3>
                <table>
                    <thead>
                        <tr>
                            <th>Verification ID</th>
                            <th>Ready Since</th>
                            <th>Customer</th>
                            <th>Food Details</th>
                            <th>Revenue Due</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.pendingPickup && pendingPickup.length > 0) { %>
                            <% pendingPickup.forEach(job => { %>
                                <tr style="background-color: #0e1a12;">
                                    <td><code style="color:#2ecc71; font-size:14px; font-weight:bold;"><%= job.orderId %></code></td>
                                    <td style="color:#888;"><%= formatTime(job.updatedAt) %></td>
                                    <td><%= job.customerName %></td>
                                    <td><%= job.quantity || 1 %>x <%= job.foodName %></td>
                                    <td style="color: #2ecc71; font-weight: bold;">₦<%= (job.totalPrice || 0).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center; color: #777; padding: 20px;">No processed meals are currently waiting at the dispatch desk.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 2: MEAL MANAGEMENT -->
        <div id="tab-meals" class="tab-content">
            <div class="section-box" style="border-color: var(--accent-green);">
                <h3 style="color: var(--accent-green); border-left-color: var(--accent-green);">➕ Add New Menu Item</h3>
                <form action="/admin/add-food" method="POST">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Meal Name</label>
                            <input type="text" name="name" placeholder="e.g. Jollof Rice & Chicken" required>
                        </div>
                        <div class="form-group">
                            <label>Price (₦)</label>
                            <input type="number" name="price" placeholder="e.g. 2500" min="0" required>
                        </div>
                        <div class="form-group">
                            <label>Processing Time (Minutes)</label>
                            <input type="number" name="processingTime" placeholder="e.g. 15" min="1" required>
                        </div>
                        <div class="form-group">
                            <label>Category / Type</label>
                            <select name="category" required>
                                <option value="Main Dish">Main Dish</option>
                                <option value="Snack">Snack</option>
                                <option value="Drink">Drink</option>
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <label>Image URL (Optional)</label>
                            <input type="url" name="imageUrl" placeholder="https://example.com/image.jpg">
                        </div>
                        <div class="form-group full-width">
                            <label>Brief Description</label>
                            <input type="text" name="description" placeholder="A brief description of the meal...">
                        </div>
                    </div>
                    <button type="submit" class="btn-primary btn-success">Save Meal to Database</button>
                </form>
            </div>

            <div class="section-box">
                <h3>🍽 Current Menu Catalog</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Meal Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Prep Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.foods && foods.length > 0) { %>
                            <% foods.forEach(food => { %>
                                <tr>
                                    <td><b><%= food.name %></b></td>
                                    <td><%= food.category || 'N/A' %></td>
                                    <td style="color:#2ecc71;">₦<%= (food.price || 0).toLocaleString() %></td>
                                    <td><%= food.processingTime %> mins</td>
                                    <td>
                                        <form action="/admin/delete-food" method="POST" style="margin:0;" onsubmit="return confirm('Delete <%= food.name %> from the menu?');">
                                            <input type="hidden" name="foodId" value="<%= food._id %>">
                                            <button type="submit" class="btn-action red">🗑 Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center; color: #777; padding: 20px;">No meals found in the database. Add one above.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 3: WEBHOOK VAULT -->
        <div id="tab-webhook" class="tab-content">
            <div class="section-box" style="background: rgba(155, 89, 182, 0.03); border: 1px dashed var(--accent-purple);">
                <h3 style="color:var(--accent-purple); border-left-color:var(--accent-purple);">⚡ Live Webhook Bypass Vault (Manual Override)</h3>
                <p style="margin: 0 0 20px 0; font-size:13px; color:var(--text-muted); line-height:1.6;">
                    In the event of a localized customer network drop where a payment is debited but the webhook fails to sync, use this panel to manually authorize or clear stale records to maintain a clean production ledger.
                </p>
                
                <form action="/admin/force-approve" method="POST" style="display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap; margin-bottom: 25px; background: var(--bg-master); padding: 20px; border-radius: 8px; border: 1px solid var(--border-glow);">
                    <div style="flex: 2; min-width: 240px;">
                        <label>Manually Force Approve by Order ID:</label>
                        <input type="text" name="orderId" placeholder="e.g., OGI-X8W2" required style="margin-top:8px;">
                    </div>
                    <div style="flex: 1; min-width: 150px;">
                        <button type="submit" class="btn-primary btn-algo" style="background: linear-gradient(135deg, var(--accent-purple), #8e44ad); width: 100%;">Push To Kitchen</button>
                    </div>
                </form>

                <label style="display: block; margin-bottom: 8px;">Inbound Unverified Transactions Pool:</label>
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Meal Selected</th>
                            <th>Bill Amount</th>
                            <th>Override Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.unverifiedOrders && unverifiedOrders.length > 0) { %>
                            <% unverifiedOrders.forEach(order => { %>
                                <tr>
                                    <td><code style="color:var(--accent-orange);"><%= order.orderId %></code></td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.quantity || 1 %>x <%= order.foodName %></td>
                                    <td style="color:var(--accent-green);">₦<%= (order.totalPrice || 0).toLocaleString() %></td>
                                    <td>
                                        <div style="display: flex; gap: 8px;">
                                            <form action="/admin/force-approve" method="POST" style="margin:0;">
                                                <input type="hidden" name="orderId" value="<%= order.orderId %>">
                                                <button type="submit" class="btn-action green">⚡ Approve</button>
                                            </form>
                                            <form action="/admin/delete-order" method="POST" style="margin:0;" onsubmit="return confirm('Are you sure you want to delete this pending transaction?');">
                                                <input type="hidden" name="orderId" value="<%= order.orderId %>">
                                                <button type="submit" class="btn-action red">🗑 Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center; color:#777; padding:20px;">No unverified standalone orders currently parked.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 4: SETTLED LEDGER -->
        <div id="tab-ledger" class="tab-content">
            <div class="section-box">
                <h3>
                    <span>📜 Settled Transaction Ledgers</span>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <a href="/admin/archive" style="color: var(--accent-blue); text-decoration: none; font-size: 13px; font-weight: 600;">🔎 Full Archives</a>
                        <span class="stat-count-badge green-badge"><%= locals.completedCount || 0 %> Finalized</span>
                    </div>
                </h3>
                <table>
                    <thead>
                        <tr>
                            <th>Verification Token</th>
                            <th>Dispatched At</th>
                            <th>Customer Name</th>
                            <th>Dispatched Foods</th>
                            <th>Revenue Extracted</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!locals.history || history.length === 0) { %>
                            <tr><td colspan="5" style="text-align:center; color: #666; padding: 20px;">No business transactions archived for today yet.</td></tr>
                        <% } else { %>
                            <% history.forEach(order => { %>
                                <tr style="background: rgba(255,255,255,0.01); color:#aaa;">
                                    <td><code style="color:#2ecc71;"><%= order.orderId %></code></td>
                                    <td style="color: #666; font-size:13px;"><%= formatTime(order.updatedAt) %></td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.quantity || 1 %>x <%= order.foodName %></td>
                                    <td style="color:#2ecc71; font-weight:bold;">₦<%= (order.totalPrice || 0).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 5: SYSTEM SETTINGS -->
        <div id="tab-settings" class="tab-content">
            <!-- ALGORITHM CONTROLLER -->
            <div class="section-box" style="background: rgba(52, 152, 219, 0.03); border: 1px dashed var(--accent-blue);">
                <h3 style="color:var(--accent-orange); border-left-color:var(--accent-orange);">⚙ Toggle Core Scheduling Logic</h3>
                <form action="/change-algo" method="POST" style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 200px;">
                        <label>Select Algorithm Framework Model:</label>
                        <select name="algorithm" style="margin-top:8px;">
                            <option value="sjf" <%= locals.algo === 'sjf' ? 'selected' : '' %>>Shortest Job First (SJF Mode)</option>
                            <option value="fifo" <%= locals.algo === 'fifo' ? 'selected' : '' %>>First-In, First-Out (FIFO Mode)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-primary btn-algo" style="margin-top: 25px;">Enforce Logic Re-Sort</button>
                </form>
            </div>

            <!-- CREATE NEW ADMIN -->
            <div class="section-box" style="border-color: var(--accent-blue);">
                <h3 style="color: var(--accent-blue); border-left-color: var(--accent-blue);">🛡️ Create Sub-Admin Account</h3>
                <form action="/admin/create-admin" method="POST">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Admin Username</label>
                            <input type="text" name="username" placeholder="e.g. japh_admin" required>
                        </div>
                        <div class="form-group">
                            <label>Secure Password</label>
                            <input type="password" name="password" placeholder="••••••••" required>
                        </div>
                        <div class="form-group full-width">
                            <label>Role</label>
                            <select name="role" required>
                                <option value="Manager">General Manager</option>
                                <option value="Staff">Kitchen Staff</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary" style="margin-top: 10px;">Provision Account</button>
                </form>
            </div>
        </div>

    </main>

    <!-- REAL-TIME BROADCAST LISTENERS & TAB LOGIC -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Socket Connection
        const socket = io();
        socket.on('queueUpdate', (data) => {
            console.log("System update received:", data?.message || "Queue modified");
            window.location.reload();
        });

        // Tab Switching Logic with LocalStorage Persistence
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            
            const targetContent = document.getElementById(tabId);
            const targetButton = document.querySelector(`[onclick="switchTab('${tabId}')"]`);
            
            if (targetContent && targetButton) {
                targetContent.classList.add('active');
                targetButton.classList.add('active');
                localStorage.setItem('ogitechAdminActiveTab', tabId);
            }
        }

        // Initialize saved tab on DOM load
        document.addEventListener('DOMContentLoaded', () => {
            const savedTab = localStorage.getItem('ogitechAdminActiveTab') || 'tab-dashboard';
            switchTab(savedTab);
        });
    </script>
</body>
</html>