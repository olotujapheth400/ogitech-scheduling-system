<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OGITECH Kitchen Monitor</title>
    
    <!-- Premium Unified Browser Tab Favicon Icon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%233498db'%3E%3Cpath d='M11 2v20H9v-2H7v-2H5v-2H3v-2H1v-2h22v2h-2v2h-2v2h-2v2h-2V2h-2zm2 5h4v2h-4zm0 4h4v2h-4zm-8 4h14v2H5zm0 4h14v2H5z'/%3E%3Cpolygon points='12,2 10,5 14,5' fill='%23d4af37'/%3E%3C/svg%3E">
    
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background-color: #111; color: #fff; display: flex; min-height: 100vh; }
        
        /* Mobile Top Bar */
        .mobile-header {
            display: none;
            background: #1c2833;
            border-bottom: 1px solid #34495e;
            padding: 12px 20px;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        .mobile-toggle {
            background: transparent;
            border: 1px solid #34495e;
            color: #fff;
            font-size: 20px;
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        /* Sidebar Navigation Layout */
        .app-sidebar { 
            width: 300px; 
            background: #1c2833; 
            padding: 25px 20px; 
            border-right: 1px solid #34495e; 
            display: flex; 
            flex-direction: column; 
            gap: 15px; 
            box-sizing: border-box;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            z-index: 90;
            transition: transform 0.3s ease;
        }

        .main-wrapper { 
            margin-left: 300px; 
            flex: 1; 
            padding: 30px; 
            box-sizing: border-box;
            max-width: calc(100% - 300px);
        }

        .container { 
            background: #222; 
            padding: 25px; 
            border-radius: 8px; 
            border: 1px solid #333; 
        }

        h2 { color: #e67e22; border-bottom: 2px solid #e67e22; padding-bottom: 10px; text-align: center; margin-top:0; }
        
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px; }
        th, td { border: 1px solid #444; padding: 12px; text-align: left; vertical-align: middle; }
        th { background-color: #333; color: #e67e22; }
        tr:nth-child(even) { background-color: #1a1a1a; }
        
        .btn-done { background: #e67e22; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn-pay { background: #27ae60; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%; }
        .badge-vip { background: #9b59b6; color: white; padding: 3px 6px; border-radius: 4px; font-size: 11px; font-weight: bold; }
        h3 { color: #5dade2; margin-top: 0; border-left: 4px solid #5dade2; padding-left: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .vip-row { border-left: 4px solid #9b59b6; background-color: #24142c !important; }
        .counter-search-panel { background: #1a252f; border: 2px dashed #3498db; padding: 20px; border-radius: 6px; }
        .search-input { padding: 10px; font-size: 14px; border-radius: 4px; background: #222; color: #fff; width: 60%; border: 1px solid #444; }
        .search-btn { padding: 10px 20px; background: #3498db; border: none; color: white; font-weight: bold; cursor: pointer; border-radius: 4px; }
        .verification-result-box { background: #1d3828; border-left: 5px solid #2ecc71; padding: 15px; margin-top: 15px; }
        .logout-btn { padding: 12px 15px; background: #e74c3c; color: white; text-decoration: none; border-radius: 6px; font-weight: bold; text-align: center; font-size: 14px; transition: background 0.2s; border: 1px solid #c0392b; margin-top: auto; }
        .logout-btn:hover { background: #c0392b; }
        .stat-count-badge { background: #34495e; color: #fff; font-size: 12px; padding: 3px 8px; border-radius: 20px; font-weight: bold; }
        .orange-badge { background: #d35400; }
        .green-badge { background: #27ae60; }
        .revenue-box { background: #111; padding: 15px; border-radius: 6px; border: 1px solid #27ae60; }
        .view-all-link { color: #3498db; text-decoration: none; font-size: 13px; font-weight: bold; }
        .view-all-link:hover { text-decoration: underline; }

        /* Sidebar Styling */
        .nav-title {
            color: #e67e22;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            padding-bottom: 8px;
            border-bottom: 1px solid #34495e;
            text-align: center;
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-link-btn {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 10px 12px;
            color: #ecf0f1;
            text-decoration: none;
            border-radius: 4px;
            background: #2c3e50;
            font-weight: bold;
            font-size: 13px;
            border: none;
            text-align: left;
            cursor: pointer;
            box-sizing: border-box;
            transition: background 0.2s;
        }

        .nav-link-btn:hover, .nav-link-btn.active {
            background: #3498db;
            color: #fff;
        }

        /* Sidebar Badge Styles */
        .sidebar-badge {
            font-size: 11px;
            padding: 2px 7px;
            border-radius: 12px;
            color: white;
            font-weight: bold;
        }

        .badge-orange { background: #e67e22; }
        .badge-green { background: #27ae60; }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Responsive Adjustments */
        @media (max-width: 768px) {
            body { flex-direction: column; }
            .mobile-header { display: flex; }
            .app-sidebar {
                top: 55px;
                transform: translateX(-100%);
                width: 260px;
                box-shadow: 10px 0 30px rgba(0,0,0,0.8);
            }
            .app-sidebar.open { transform: translateX(0); }
            .main-wrapper {
                margin-left: 0;
                max-width: 100%;
                padding: 70px 15px 20px 15px;
            }
            .search-input { width: 100%; }
            .counter-search-panel form { flex-direction: column; }
        }
    </style>
</head>
<body>

<!-- Mobile Header -->
<header class="mobile-header">
    <h3 style="color:#e67e22; margin:0; font-size:1.1rem; border:none; padding:0;">OGITECH Kitchen</h3>
    <button class="mobile-toggle" onclick="toggleSidebar()">☰</button>
</header>

<!-- Left Navigation Sidebar -->
<div class="app-sidebar" id="sidebar">
    <!-- 1. Revenue at Top of Everything -->
    <div class="revenue-box">
        <h3 style="color:#2ecc71; border:none; padding:0; margin-bottom:5px; font-size: 15px;">💳 Online Sales Revenue</h3>
        <p style="font-size:24px; font-weight:bold; color:#2ecc71; margin:0;">₦<%= locals.revenue ? Number(revenue).toLocaleString() : '0' %></p>
    </div>

    <div class="nav-title">👨‍🍳 Kitchen Control Panel</div>
    
    <!-- 2. Sidebar Navigation Items with Count Badges -->
    <div class="nav-menu">
        <button class="nav-link-btn" id="btn-allView" onclick="switchTab('allView')">
            <span>📊 Operational Dashboard</span>
        </button>
        <button class="nav-link-btn" id="btn-despatchTool" onclick="switchTab('despatchTool')">
            <span>💳 Online Order Verification</span>
        </button>
        <button class="nav-link-btn" id="btn-activeQueue" onclick="switchTab('activeQueue')">
            <span>🍳 Active Kitchen Queue</span>
            <% if (locals.jobs && jobs.length > 0) { %>
                <span class="sidebar-badge badge-orange"><%= jobs.length %></span>
            <% } %>
        </button>
        <button class="nav-link-btn" id="btn-counterPickup" onclick="switchTab('counterPickup')">
            <span>⏳ Counter Pickup Desk</span>
            <% if (locals.pendingPickup && pendingPickup.length > 0) { %>
                <span class="sidebar-badge badge-orange"><%= pendingPickup.length %></span>
            <% } %>
        </button>
        <button class="nav-link-btn" id="btn-settledArchive" onclick="switchTab('settledArchive')">
            <span>📜 Settled Archive (Last 10)</span>
        </button>
        <a href="/staff/archive" class="nav-link-btn" style="background:#16a085; text-align:center; display:block;">🔎 Full Ledger Logs</a>
    </div>

    <!-- 3. Logout Button at Bottom -->
    <a href="/staff-logout" class="logout-btn">🔒 Lock Station Log Out</a>
</div>

<!-- Main Content Area -->
<div class="main-wrapper">
    <div class="container">
        <h2>🍳 OGITECH Kitchen Cook Monitor</h2>
        <p style="text-align: center; color: #aaa; margin-bottom: 25px;">
            Live Operating Framework Matrix: 
            <span style="color:#e67e22; font-weight:bold; text-transform: uppercase;">
                <%= locals.algo === 'sjf' ? 'Shortest Job First (SJF Mode)' : 'First-In, First-Out (FIFO Mode)' %> Active
            </span>
        </p>

        <!-- TAB 1: ALL-IN-ONE OPERATIONAL DASHBOARD -->
        <div id="allView" class="tab-content">
            <div class="counter-search-panel" style="margin-bottom: 25px;">
                <h3>💳 Online Despatch Verification Tool</h3>
                <form action="/staff" method="GET" style="display:flex; gap:10px;">
                    <input type="text" name="counterSearchId" placeholder="e.g. OGI-W3A4" class="search-input" value="<%= locals.counterSearchQuery || '' %>" required>
                    <button type="submit" class="search-btn">Verify Receipt Token</button>
                </form>

                <% if (locals.matchedCounterOrder) { %>
                    <div class="verification-result-box">
                        <span style="color:#2ecc71; font-weight:bold;">✔ MATCH FOUND FOR TICKET [<%= matchedCounterOrder.orderId %>]</span>
                        <p style="line-height: 1.6; margin-top: 10px;">
                            <b>Customer Name:</b> <%= matchedCounterOrder.customerName %><br>
                            <b>Assigned Meal Plate:</b> <span style="color:#f1c40f; font-weight:bold;"><%= matchedCounterOrder.quantity || 1 %>x <%= matchedCounterOrder.foodName %></span><br>
                            <b>Total Paid:</b> ₦<%= (matchedCounterOrder.totalPrice || 0).toLocaleString() %>
                        </p>
                        <form action="/pickup-job/<%= matchedCounterOrder._id %>" method="POST">
                            <button type="submit" class="btn-pay">✅ Verify Payment & Despatch Meal Plate</button>
                        </form>
                    </div>
                <% } else if (locals.counterSearchQuery && locals.counterSearchError) { %>
                    <div class="verification-result-box" style="background:#441a1a; border-left-color:#e74c3c; color:#ff9999;">
                        ❌ No pending order found for verification code "<%= locals.counterSearchQuery %>".
                    </div>
                <% } %>
            </div>

            <h3>
                <span>Active Kitchen Queue</span>
                <span class="stat-count-badge orange-badge"><%= locals.jobs ? jobs.length : 0 %> Incoming Orders</span>
            </h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>Rank</th><th>Order ID</th><th>Inbound Time</th><th>Customer Name</th><th>Food Item</th><th>Est Time</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% if (locals.jobs && jobs.length > 0) { %>
                            <% jobs.forEach((job, index) => { %>
                                <tr class="<%= job.priority === 1 ? 'vip-row' : '' %>">
                                    <td><b>#<%= index + 1 %></b></td>
                                    <td><code><%= job.orderId %></code></td>
                                    <td style="color:#888;">
                                        <%= new Date(job.createdAt || Date.now()).toLocaleString('en-US', { 
                                            weekday: 'short', 
                                            month: 'short', 
                                            day: 'numeric', 
                                            year: 'numeric', 
                                            hour: '2-digit', 
                                            minute: '2-digit', 
                                            hour12: true 
                                        }) %>
                                    </td>
                                    <td><%= job.customerName %> <% if (job.priority === 1) { %><span class="badge-vip">VIP</span><% } %></td>
                                    <td>
                                        <%= job.quantity || 1 %>x <%= job.foodName %>
                                        <br>
                                        <small style="color: #2ecc71; font-weight: bold; font-size: 0.85rem;">
                                            ₦<%= (job.totalPrice || 0).toLocaleString() %>
                                        </small>
                                    </td>
                                    <td><%= (job.processingTime || 0) * (job.quantity || 1) %> mins</td>
                                    <td>
                                        <form action="/complete-job/<%= job._id %>" method="POST" style="margin:0;">
                                            <button type="submit" class="btn-done">Send to Counter</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" style="text-align:center; color: #777; padding: 15px;">No active dishes are cooking in the kitchen right now.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <h3>
                <span>⏳ Counter Pickup Desk (Overview of Awaiting Collections)</span>
                <span class="stat-count-badge orange-badge"><%= locals.pendingPickup ? pendingPickup.length : 0 %> Pending Pickup</span>
            </h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>Verification ID</th><th>Ready Since</th><th>Customer Name</th><th>Food Item</th><th>Total Paid</th></tr>
                    </thead>
                    <tbody>
                        <% if (locals.pendingPickup && pendingPickup.length > 0) { %>
                            <% pendingPickup.forEach(job => { %>
                                <tr style="background-color: #1a251f;">
                                    <td><code><%= job.orderId %></code></td>
                                    <td style="color: #888;">
                                        <%= new Date(job.updatedAt || job.createdAt || Date.now()).toLocaleString('en-US', { 
                                            weekday: 'short', 
                                            month: 'short', 
                                            day: 'numeric', 
                                            year: 'numeric', 
                                            hour: '2-digit', 
                                            minute: '2-digit', 
                                            hour12: true 
                                        }) %>
                                    </td>
                                    <td><%= job.customerName %></td>
                                    <td><%= job.quantity || 1 %>x <%= job.foodName %></td>
                                    <td style="color: #2ecc71; font-weight: bold;">₦<%= (job.totalPrice || 0).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center; color: #777; padding: 15px;">No meals waiting at counter.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <h3>
                <span>📜 Settled Archive (Showing Last 10)</span>
                <div style="display:flex; align-items:center; gap:12px;">
                    <a href="/staff/archive" class="view-all-link">🔎 View Full Ledgers</a>
                    <span class="stat-count-badge green-badge"><%= locals.completedCount || 0 %> Dispatched Total</span>
                </div>
            </h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>Order ID</th><th>Dispatched At</th><th>Customer Name</th><th>Meal Dispatched</th><th>Amount Paid</th></tr>
                    </thead>
                    <tbody>
                        <% if (locals.history && history.length > 0) { %>
                            <% history.forEach(order => { %>
                                <tr style="background: #161616; color:#aaa;">
                                    <td><code style="color:#2ecc71;"><%= order.orderId %></code></td>
                                    <td style="color: #888; font-size:13px;">
                                        <%= new Date(order.updatedAt || order.createdAt || Date.now()).toLocaleString('en-US', { 
                                            weekday: 'short', 
                                            month: 'short', 
                                            day: 'numeric', 
                                            year: 'numeric', 
                                            hour: '2-digit', 
                                            minute: '2-digit', 
                                            hour12: true 
                                        }) %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.quantity || 1 %>x <%= order.foodName %></td>
                                    <td style="color:#2ecc71; font-weight:bold;">₦<%= (order.totalPrice || 0).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center; color: #666; padding: 15px;">No business transactions finalized yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 2: VERIFICATION TOOL ONLY -->
        <div id="despatchTool" class="tab-content">
            <div class="counter-search-panel">
                <h3>💳 Online Despatch Verification Tool</h3>
                <form action="/staff" method="GET" style="display:flex; gap:10px;">
                    <input type="text" name="counterSearchId" placeholder="e.g. OGI-W3A4" class="search-input" value="<%= locals.counterSearchQuery || '' %>" required>
                    <button type="submit" class="search-btn">Verify Receipt Token</button>
                </form>

                <% if (locals.matchedCounterOrder) { %>
                    <div class="verification-result-box">
                        <span style="color:#2ecc71; font-weight:bold;">✔ MATCH FOUND FOR TICKET [<%= matchedCounterOrder.orderId %>]</span>
                        <p style="line-height: 1.6; margin-top: 10px;">
                            <b>Customer Name:</b> <%= matchedCounterOrder.customerName %><br>
                            <b>Assigned Meal Plate:</b> <span style="color:#f1c40f; font-weight:bold;"><%= matchedCounterOrder.quantity || 1 %>x <%= matchedCounterOrder.foodName %></span><br>
                            <b>Total Paid:</b> ₦<%= (matchedCounterOrder.totalPrice || 0).toLocaleString() %>
                        </p>
                        <form action="/pickup-job/<%= matchedCounterOrder._id %>" method="POST">
                            <button type="submit" class="btn-pay">✅ Verify Payment & Despatch Meal Plate</button>
                        </form>
                    </div>
                <% } else if (locals.counterSearchQuery && locals.counterSearchError) { %>
                    <div class="verification-result-box" style="background:#441a1a; border-left-color:#e74c3c; color:#ff9999;">
                        ❌ No pending order found for verification code "<%= locals.counterSearchQuery %>".
                    </div>
                <% } %>
            </div>
        </div>

        <!-- TAB 3: ACTIVE KITCHEN QUEUE ONLY -->
        <div id="activeQueue" class="tab-content">
            <h3>
                <span>Active Kitchen Queue</span>
                <span class="stat-count-badge orange-badge"><%= locals.jobs ? jobs.length : 0 %> Incoming Orders</span>
            </h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>Rank</th><th>Order ID</th><th>Inbound Time</th><th>Customer Name</th><th>Food Item</th><th>Est Time</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% if (locals.jobs && jobs.length > 0) { %>
                            <% jobs.forEach((job, index) => { %>
                                <tr class="<%= job.priority === 1 ? 'vip-row' : '' %>">
                                    <td><b>#<%= index + 1 %></b></td>
                                    <td><code><%= job.orderId %></code></td>
                                    <td style="color:#888;">
                                        <%= new Date(job.createdAt || Date.now()).toLocaleString('en-US', { 
                                            weekday: 'short', 
                                            month: 'short', 
                                            day: 'numeric', 
                                            year: 'numeric', 
                                            hour: '2-digit', 
                                            minute: '2-digit', 
                                            hour12: true 
                                        }) %>
                                    </td>
                                    <td><%= job.customerName %> <% if (job.priority === 1) { %><span class="badge-vip">VIP</span><% } %></td>
                                    <td>
                                        <%= job.quantity || 1 %>x <%= job.foodName %>
                                        <br>
                                        <small style="color: #2ecc71; font-weight: bold; font-size: 0.85rem;">
                                            ₦<%= (job.totalPrice || 0).toLocaleString() %>
                                        </small>
                                    </td>
                                    <td><%= (job.processingTime || 0) * (job.quantity || 1) %> mins</td>
                                    <td>
                                        <form action="/complete-job/<%= job._id %>" method="POST" style="margin:0;">
                                            <button type="submit" class="btn-done">Send to Counter</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" style="text-align:center; color: #777; padding: 15px;">No active dishes are cooking in the kitchen right now.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 4: COUNTER PICKUP DESK ONLY -->
        <div id="counterPickup" class="tab-content">
            <h3>
                <span>⏳ Counter Pickup Desk (Overview of Awaiting Collections)</span>
                <span class="stat-count-badge orange-badge"><%= locals.pendingPickup ? pendingPickup.length : 0 %> Pending Pickup</span>
            </h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>Verification ID</th><th>Ready Since</th><th>Customer Name</th><th>Food Item</th><th>Total Paid</th></tr>
                    </thead>
                    <tbody>
                        <% if (locals.pendingPickup && pendingPickup.length > 0) { %>
                            <% pendingPickup.forEach(job => { %>
                                <tr style="background-color: #1a251f;">
                                    <td><code><%= job.orderId %></code></td>
                                    <td style="color: #888;">
                                        <%= new Date(job.updatedAt || job.createdAt || Date.now()).toLocaleString('en-US', { 
                                            weekday: 'short', 
                                            month: 'short', 
                                            day: 'numeric', 
                                            year: 'numeric', 
                                            hour: '2-digit', 
                                            minute: '2-digit', 
                                            hour12: true 
                                        }) %>
                                    </td>
                                    <td><%= job.customerName %></td>
                                    <td><%= job.quantity || 1 %>x <%= job.foodName %></td>
                                    <td style="color: #2ecc71; font-weight: bold;">₦<%= (job.totalPrice || 0).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center; color: #777; padding: 15px;">No meals waiting at counter.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 5: SETTLED ARCHIVE (LAST 10) ONLY -->
        <div id="settledArchive" class="tab-content">
            <h3>
                <span>📜 Settled Archive (Showing Last 10)</span>
                <div style="display:flex; align-items:center; gap:12px;">
                    <a href="/staff/archive" class="view-all-link">🔎 View Full Ledgers</a>
                    <span class="stat-count-badge green-badge"><%= locals.completedCount || 0 %> Dispatched Total</span>
                </div>
            </h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>Order ID</th><th>Dispatched At</th><th>Customer Name</th><th>Meal Dispatched</th><th>Amount Paid</th></tr>
                    </thead>
                    <tbody>
                        <% if (locals.history && history.length > 0) { %>
                            <% history.forEach(order => { %>
                                <tr style="background: #161616; color:#aaa;">
                                    <td><code style="color:#2ecc71;"><%= order.orderId %></code></td>
                                    <td style="color: #888; font-size:13px;">
                                        <%= new Date(order.updatedAt || order.createdAt || Date.now()).toLocaleString('en-US', { 
                                            weekday: 'short', 
                                            month: 'short', 
                                            day: 'numeric', 
                                            year: 'numeric', 
                                            hour: '2-digit', 
                                            minute: '2-digit', 
                                            hour12: true 
                                        }) %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.quantity || 1 %>x <%= order.foodName %></td>
                                    <td style="color:#2ecc71; font-weight:bold;">₦<%= (order.totalPrice || 0).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align:center; color: #666; padding: 15px;">No business transactions finalized yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- Carrier element to pass EJS active tab and search state into JS safely -->
<div id="server-data" 
     data-active-tab="<%= locals.activeTab || '' %>" 
     data-search-query="<%= locals.counterSearchQuery || '' %>" 
     style="display:none;"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    socket.on('queueUpdate', (data) => {
        console.log("System update received:", data.message);
        window.location.reload();
    });

    const serverDataEl = document.getElementById('server-data');
    const activeTabKey = serverDataEl ? serverDataEl.dataset.activeTab : '';
    const counterSearchQuery = serverDataEl ? serverDataEl.dataset.searchQuery : '';

    document.addEventListener("DOMContentLoaded", () => {
        const tabMapping = {
            'dashboard': 'allView',
            'allView': 'allView',
            'despatchTool': 'despatchTool',
            'unverified': 'despatchTool',
            'queue': 'activeQueue',
            'activeQueue': 'activeQueue',
            'counterPickup': 'counterPickup',
            'pickup': 'counterPickup',
            'settledArchive': 'settledArchive',
            'ledger': 'settledArchive'
        };

        let targetTabId = 'allView';

        if (counterSearchQuery) {
            targetTabId = 'despatchTool';
        } else if (activeTabKey && tabMapping[activeTabKey]) {
            targetTabId = tabMapping[activeTabKey];
        }

        switchTab(targetTabId);
    });

    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('open');
    }

    function switchTab(tabId) {
        const tabContents = document.querySelectorAll('.tab-content');
        tabContents.forEach(content => content.classList.remove('active'));

        const navButtons = document.querySelectorAll('.nav-link-btn');
        navButtons.forEach(btn => btn.classList.remove('active'));

        const targetContent = document.getElementById(tabId);
        if (targetContent) {
            targetContent.classList.add('active');
        }

        const targetBtn = document.getElementById('btn-' + tabId);
        if (targetBtn) {
            targetBtn.classList.add('active');
        }

        const sidebar = document.getElementById('sidebar');
        if (sidebar.classList.contains('open')) {
            sidebar.classList.remove('open');
        }
    }
</script>
</body>
</html>