    <!-- Interactive Scripts -->
    <script>
        function checkOperatingStatus() {
            const now = new Date();
            const currentHour = now.getHours();
            const statusBadge = document.getElementById('operating-status');

            if (currentHour >= 8 && currentHour < 17) {
                statusBadge.className = 'status-badge status-open';
                statusBadge.innerHTML = '<i class="fas fa-circle" style="font-size: 0.5rem;"></i> Cafeteria OPEN';
            } else {
                statusBadge.className = 'status-badge status-closed';
                statusBadge.innerHTML = '<i class="fas fa-circle" style="font-size: 0.5rem;"></i> Cafeteria CLOSED';
            }
        }

        function openSjfModal() {
            document.getElementById('sjfModal').style.display = 'flex';
        }

        function closeSjfModal() {
            document.getElementById('sjfModal').style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('sjfModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        };

        document.addEventListener('DOMContentLoaded', checkOperatingStatus);
    </script>
