<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Login - OGITECH Express</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white flex items-center justify-center h-screen m-0">

    <div class="bg-gray-800 p-8 rounded-xl shadow-2xl w-full max-w-md border border-gray-700">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold tracking-wider text-red-500">OGITECH Express</h1>
            <p class="text-gray-400 text-sm mt-1">Kitchen Staff Portal Login</p>
        </div>

        <% if (error) { %>
            <div class="bg-red-500/10 border border-red-500 text-red-400 px-4 py-3 rounded mb-4 text-sm text-center">
                Invalid username or password. Please try again.
            </div>
        <% } %>

        <form action="/ogitech-kitchen-gate-2026" method="POST" class="space-y-4">
            <div>
                <label class="block text-gray-300 text-sm font-semibold mb-2" for="username">Staff Username</label>
                <input class="w-full px-3 py-2 bg-gray-900 rounded border border-gray-700 text-white focus:outline-none focus:border-red-500" 
                       type="text" id="username" name="username" required autocomplete="username">
            </div>

            <div>
                <label class="block text-gray-300 text-sm font-semibold mb-2" for="password">Password</label>
                <input class="w-full px-3 py-2 bg-gray-900 rounded border border-gray-700 text-white focus:outline-none focus:border-red-500" 
                       type="password" id="password" name="password" required autocomplete="current-password">
            </div>

            <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded transition duration-200">
                Sign In to Kitchen
            </button>
        </form>

        <div class="text-center mt-6">
            <a href="/" class="text-sm text-gray-400 hover:text-white transition">&larr; Back to Home</a>
        </div>
    </div>

</body>
</html>